# Host port; Compose binds it to 127.0.0.1.
BILIMCP_PORT=8000
# Request concurrency, actual sends per call, and spacing between sends.
FXBILIBILI_UPSTREAM_CONCURRENCY=3
FXBILIBILI_UPSTREAM_REQUESTS_PER_CALL=64
FXBILIBILI_UPSTREAM_REQUESTS_PER_MINUTE=0
FXBILIBILI_UPSTREAM_SPACING_SECONDS=0.1
# In-memory cache: 256 MiB. Public data: 4 GiB. Video blocks: 20 GiB.
FXBILIBILI_CACHE_MAX_BYTES=268435456
FXBILIBILI_HISTORY_MAX_BYTES=4294967296
FXBILIBILI_VIDEO_CACHE_MAX_BYTES=21474836480
